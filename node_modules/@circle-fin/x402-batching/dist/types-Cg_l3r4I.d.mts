import { Address, Hex } from 'viem';

/**
 * EIP-712 domain name for Circle Gateway batched payments.
 * Used in the `extra.name` field of PaymentRequirements to identify Circle batching options.
 */
declare const CIRCLE_BATCHING_NAME = "GatewayWalletBatched";
/**
 * EIP-712 domain version for Circle Gateway batched payments.
 * Used in the `extra.version` field of PaymentRequirements.
 */
declare const CIRCLE_BATCHING_VERSION = "1";
/**
 * The payment scheme used for Circle batching (same as standard x402 exact scheme).
 */
declare const CIRCLE_BATCHING_SCHEME = "exact";
/**
 * Authorization validity window the SDK should publish and sign with.
 */
declare const GATEWAY_AUTH_VALIDITY_WINDOW_SECONDS: number;

/**
 * Extra fields specific to Circle Gateway batching in PaymentRequirements.
 */
interface BatchExtra {
    /** EIP-712 domain name - must be "GatewayWalletBatched" */
    name: typeof CIRCLE_BATCHING_NAME;
    /** EIP-712 domain version - must be "1" */
    version: typeof CIRCLE_BATCHING_VERSION;
    /** The GatewayWallet contract address used as verifyingContract in EIP-712 */
    verifyingContract: Address;
}
/**
 * Configuration for BatchFacilitatorClient.
 */
interface BatchFacilitatorConfig {
    /** Base URL of Circle Gateway. Defaults to "https://gateway-api.circle.com" */
    url?: string;
    /** Optional function to create auth headers for requests */
    createAuthHeaders?: () => Promise<{
        verify: Record<string, string>;
        settle: Record<string, string>;
        supported: Record<string, string>;
    }>;
}
/**
 * EIP-3009 TransferWithAuthorization message structure.
 */
interface TransferWithAuthorizationMessage {
    from: Address;
    to: Address;
    value: bigint;
    validAfter: bigint;
    validBefore: bigint;
    nonce: Hex;
}
/**
 * EVM signer interface for creating payment payloads.
 */
interface BatchEvmSigner {
    /** The signer's address */
    address: Address;
    /** Sign EIP-712 typed data */
    signTypedData: (params: {
        domain: {
            name: string;
            version: string;
            chainId: number;
            verifyingContract: Address;
        };
        types: Record<string, Array<{
            name: string;
            type: string;
        }>>;
        primaryType: string;
        message: Record<string, unknown>;
    }) => Promise<Hex>;
}
/**
 * Payload structure for batching payments.
 */
interface BatchPayload {
    signature: Hex;
    authorization: {
        from: Address;
        to: Address;
        value: string;
        validAfter: string;
        validBefore: string;
        nonce: Hex;
    };
}

export { type BatchFacilitatorConfig as B, CIRCLE_BATCHING_NAME as C, GATEWAY_AUTH_VALIDITY_WINDOW_SECONDS as G, type TransferWithAuthorizationMessage as T, type BatchPayload as a, type BatchEvmSigner as b, CIRCLE_BATCHING_VERSION as c, CIRCLE_BATCHING_SCHEME as d, type BatchExtra as e };
